# Copy to .env and adjust. Every setting can also be passed as an environment variable.
# Never commit your real .env file.

# --- Providers: fake | openai | azure --------------------------------------
# "fake" runs fully offline (hashing embeddings + extractive answers) for demos and tests.
RAG_LLM_PROVIDER=fake
RAG_EMBEDDING_PROVIDER=fake
# RAG_FAKE_EMBEDDING_DIM=384

# --- OpenAI-compatible (OpenAI, Ollama, vLLM, LM Studio, ...) ---------------
# OpenAI:  RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama:  RAG_OPENAI_BASE_URL=http://localhost:11434/v1   (no API key needed)
# vLLM:    RAG_OPENAI_BASE_URL=http://localhost:8001/v1
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI -----------------------------------------------------------
RAG_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
RAG_AZURE_OPENAI_API_KEY=
RAG_AZURE_OPENAI_API_VERSION=2024-10-21
RAG_AZURE_OPENAI_CHAT_DEPLOYMENT=
RAG_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Generation -------------------------------------------------------------
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_MAX_TOKENS=512
RAG_REQUEST_TIMEOUT_S=60
RAG_EMBEDDING_BATCH_SIZE=64

# --- Vector store: memory | sqlite | pgvector -------------------------------
RAG_VECTOR_STORE=sqlite
RAG_SQLITE_PATH=data/rag.db
# RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# RAG_PG_TABLE=rag_chunks

# --- Chunking ---------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_HEADING_AWARE=true

# --- Retrieval ----------------------------------------------------------------
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_RRF_K=60
# none | overlap  (or pass your own Reranker in code)
RAG_RERANKER=none

# --- API / access control -------------------------------------------------------
# JSON map of API key -> collections it may read and write ("*" = all collections).
# Leave empty ({}) to disable auth for local development only.
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEYS={"change-me-demo-key": ["demo"]}
RAG_MAX_UPLOAD_MB=25
# RAG_CORS_ORIGINS=["http://localhost:3000"]
